     }
     this.stmtDeleteMeta = this.db.prepare("DELETE FROM l1_records WHERE record_id = ?");
 
+    // Reads go through the view so an archived record's vector stops producing a hit.
+    // searchL1Vector already skips a hit whose metadata is missing (it logs "vector
+    // but NO metadata (orphan)"), so this degrades into "skipped", not "half-filled".
     this.stmtGetMeta = this.db.prepare(`
       SELECT content, type, priority, scene_name, session_key, session_id, team_id, task_id, user_id, agent_id,
